{
    "name": "sikelan/framework",
    "description": "A high-performance PHP framework based on Swoole",
    "type": "library",
    "require": {
        "php": "^7.4",
        "ext-swoole": "^4.6.3",
        "psr/container": "^1.1",
        "psr/log": "^1.1",
        "psr/http-message": "^1.0",
        "symfony/console": "^5.4",
        "symfony/event-dispatcher": "^5.4",
        "symfony/yaml": "^5.4",
        "nikic/fast-route": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "autoload": {
        "psr-4": {
            "Sikelan\\": "sikelan/",
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sikelan\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/sikelan"
    ],
    "scripts": {
        "test": "./vendor/bin/phpunit --testdox",
        "test:stest": "./vendor/bin/phpunit tests/stest/ --testdox",
        "test:atest": "./vendor/bin/phpunit tests/atest/ --testdox",
        "lint": "./vendor/bin/phpcs --standard=phpcs.xml",
        "lint:fix": "./vendor/bin/phpcbf --standard=phpcs.xml",
        "start": "php bin/sikelan server start -e=dev",
        "start:http": "php bin/sikelan server start -e=dev -m=http",
        "start:websocket": "php bin/sikelan server start -e=dev -m=websocket",
        "start:tcp": "php bin/sikelan server start -e=dev -m=tcp",
        "serve": "php bin/sikelan server start",
        "serve:dev": "php bin/sikelan server start -e=dev",
        "serve:prod": "php bin/sikelan server start -e=prod",
        "serve:stop": "php bin/sikelan server stop",
        "serve:restart": "php bin/sikelan server restart",
        "serve:status": "php bin/sikelan server status"
    },
    "config": {
        "optimize-autoloader": true,
        "process-timeout": 0,
        "audit": {
            "block-insecure": false
        }
    }
}