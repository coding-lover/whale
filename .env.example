# ========================================
# Sikelan Framework Environment Config
# ========================================
# 复制此文件为 .env 并根据需要修改配置值
# cp .env.example .env

# ----------------------------------------
# 应用配置
# ----------------------------------------

# 环境标识：development / testing / production
# 注意：命令行参数 --env 优先级最高，会覆盖此配置
APP_ENV=development

# 应用名称
APP_NAME=Sikelan

# 调试模式 (true/false)
APP_DEBUG=true

# 日志级别：debug / info / warning / error
APP_LOG_LEVEL=debug

# 日志路径
APP_LOG_PATH=/path/to/logs

# 日志通道
APP_LOG_CHANNEL=app

# ----------------------------------------
# 服务器配置
# ----------------------------------------

# 服务器主机地址
SERVER_HOST=0.0.0.0

# 服务器端口
SERVER_PORT=9502

# Worker 进程数
SERVER_WORKER_NUM=8

# 最大请求数（单个 Worker 处理的最大请求数后自动重启）
SERVER_MAX_REQUEST=10000

# Task Worker 进程数
SERVER_TASK_WORKER_NUM=4

# Swoole 日志文件路径
SERVER_LOG_FILE=/path/to/logs/swoole.log

# PID 文件路径
SERVER_PID_FILE=/path/to/runtime/server.pid

# ----------------------------------------
# 数据库配置
# ----------------------------------------

# MySQL 主机地址
DB_HOST=127.0.0.1

# MySQL 端口
DB_PORT=3306

# MySQL 用户名
DB_USERNAME=root

# MySQL 密码
DB_PASSWORD=

# 数据库名称
DB_DATABASE=sikelan

# 连接池大小
DB_POOL_SIZE=10

# 连接超时（秒）
DB_TIMEOUT=10

# ----------------------------------------
# Redis 缓存配置
# ----------------------------------------

# Redis 主机地址
REDIS_HOST=127.0.0.1

# Redis 端口
REDIS_PORT=6379

# Redis 密码
REDIS_PASSWORD=

# Redis 数据库索引
REDIS_DATABASE=0

# Redis 连接超时（秒）
REDIS_TIMEOUT=5

# ----------------------------------------
# 交易所配置
# ----------------------------------------

# 默认交易所：binance / okx
EXCHANGE_DEFAULT=binance

# 交易所 HTTP 代理（用于访问被墙的交易所 API）
EXCHANGE_PROXY_ENABLED=false
EXCHANGE_PROXY_HOST=127.0.0.1
EXCHANGE_PROXY_PORT=6666

# 交易所调试日志（打印 HTTP 请求/响应详情，排查代理连接问题）
EXCHANGE_DEBUG_LOG=false

# Binance API
BINANCE_TESTNET=false
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_SSL_VERIFY=true

# OKX API

# OKX API（OKX 额外需要 passphrase）
OKX_TESTNET=false
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
OKX_SSL_VERIFY=true
