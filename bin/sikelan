#!/usr/bin/env php
<?php

$autoloadPath = __DIR__ . '/../vendor/autoload.php';

if (!file_exists($autoloadPath)) {
    echo "\033[31mError: vendor/autoload.php not found.\033[0m\n";
    echo "Please run 'composer install' first.\n";
    exit(1);
}

require $autoloadPath;

// 加载系统常量和公用函数
$constantsPath = __DIR__ . '/../sikelan/Core/constants.php';
if (file_exists($constantsPath)) {
    require_once $constantsPath;
}

$commonPath = __DIR__ . '/../sikelan/Core/common.php';
if (file_exists($commonPath)) {
    require_once $commonPath;
}

use Sikelan\Command\CommandRunner;

if (extension_loaded('xdebug')) {
    @ini_set('xdebug.mode', 'off');
    @ini_set('xdebug.start_with_request', 'no');
}

$runner = CommandRunner::getInstance();
$exitCode = $runner->run($argv);

exit($exitCode);
